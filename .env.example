# =============================================================================
# SIDA — identidade de nó da frota (Etapa 1 do Ciclo V3.0)
# =============================================================================
# Template. Copie para o .env do nó (NAO versionado) ou use os arquivos prontos
# em deploy/fleet/edge_00X.env:
#
#   docker compose --env-file deploy/fleet/edge_001.env up -d
#
# Toda a identidade do no vem daqui — nada e hardcoded em codigo/imagem/flows.
# O sida-core expoe EDGE_GATEWAY_ID em GET /api/system/info, e os flows Node-RED
# (ingestion/context/delivery) derivam dele o resto da identidade.
# -----------------------------------------------------------------------------

# --- Plano norte (A) — ciclo de vida Sparkplug B / MQTT ao UNS ---------------
# Identificador do gateway = edge_node_id Sparkplug (clientId MQTT, topico
# spBv1.0/{GROUP_ID}/+/{EDGE_GATEWAY_ID}). Unico por no.
EDGE_GATEWAY_ID=sida_edge_001

# group_id Sparkplug = {Enterprise}_{Site}. Igual para nos do mesmo sitio.
GROUP_ID=Enterprise_Site

# URL do broker MQTT do UNS. Em producao aponta para o broker do GCP; nos
# testes isolados aponta para o Mosquitto local (mqtt://mosquitto:1883).
BROKER_URL=mqtt://mosquitto:1883

# PIN de engenheiro (auth do sida-core). NAO usar este valor em producao.
EDGE_ENGINEER_PIN=000000

# --- Plano leste-oeste (B) — malha controller-to-controller InterEdge --------
# Identificador do controlador nesta malha. Convencao: mesmo sufixo do gateway.
CONTROLLER_ID=edge_001

# Porta dedicada do peer-mesh ZeroMQ (ROUTER/DEALER). NUNCA 5556 (manifesto).
PEER_PORT=5557

# Pares conhecidos: lista "id@host:port" separada por virgula. Vazio = sem pares.
PEERS=edge_002@sida-core-002:5557,edge_003@sida-core-003:5557

# Cadencia do probe (ms) e nº de probes sem ACK ate marcar o par como 'down'.
PROBE_INTERVAL_MS=1000
PEER_DOWN_AFTER_MISSES=3

# --- Diversos ---------------------------------------------------------------
TZ=America/Recife
