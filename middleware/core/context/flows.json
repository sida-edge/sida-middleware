    {
        "id": "d97f83548be2d1c9",
        "type": "function",
        "z": "d46c639dccb35b93",
        "g": "48657daa48033bec",
        "name": "contextualizeData",
        "func": "try {\n    const payloadIn = msg.topic;\n    if (!payloadIn?.source?.device_id || !payloadIn?.data) {\n        return null;\n    }\n\n    const deviceId = payloadIn.source.device_id;\n    const manifest = global.get(\"manifest\");\n\n    if (!manifest?.config?.plant) {\n        node.error(\"Manifest ausente ou configuração da planta inválida no contexto global.\");\n        return null;\n    }\n\n    let deviceCache = context.get(\"deviceCache\") || {};\n    let lastValuesCache = context.get(\"lastValuesCache\") || {};\n\n    const currentManifestHash = JSON.stringify(manifest);\n    let cachedManifestHash = context.get(\"manifestHash\");\n\n    if (!cachedManifestHash || currentManifestHash !== cachedManifestHash) {\n        deviceCache = {};\n        lastValuesCache = {};\n\n        const areas = manifest.config.plant.areas || {};\n        for (const areaId in areas) {\n            const lines = areas[areaId].lines || {};\n            for (const lineId in lines) {\n                const devices = lines[lineId].devices || {};\n                for (const devId in devices) {\n                    deviceCache[devId] = devices[devId];\n                }\n            }\n        }\n\n        context.set(\"deviceCache\", deviceCache);\n        context.set(\"lastValuesCache\", lastValuesCache);\n        context.set(\"manifestHash\", currentManifestHash);\n        node.log(\"Cache de dispositivos e estados atualizados via Hash do Manifest\");\n    }\n\n    const foundDevice = deviceCache[deviceId];\n\n    if (!foundDevice) {\n        node.warn(`Dispositivo '${deviceId}' não encontrado no manifest atual.`);\n        return null;\n    }\n\n    const plant = manifest.config.plant;\n    const assetPath = [\n        { type: \"enterprise\", id: plant.enterprise },\n        { type: \"site\", id: plant.site }\n    ].concat(foundDevice.asset_context?.path || []);\n\n    const rawData = payloadIn.data;\n    if (rawData[\"@status\"] !== undefined && rawData[\"@status\"] === 0) {\n        \n        const device_id_isa95 = assetPath\n            .filter(p => [\"area\", \"line\", \"equipment\"].includes(p.type))\n            .map(p => p.id)\n            .join('_');\n            \n        msg.topic = \"device_offline\";\n        msg.payload = { device_id: device_id_isa95 };\n        \n        node.warn(`Alerta de sistema: Dispositivo ${device_id_isa95} caiu!`);\n        return msg; \n    }\n\n    const mappedData = [];\n    const deviceState = lastValuesCache[deviceId] || {};\n\n    for (const key in rawData) {\n        const mapping = foundDevice.metrics_mapping?.[key]\n            || Object.values(foundDevice.metrics_mapping || {}).find(m => m.name === key);\n\n        if (mapping) {\n            let finalValue = rawData[key];\n\n            if (Array.isArray(finalValue) && finalValue.length >= 2) {\n                const buffer = Buffer.alloc(4);\n                buffer.writeUint16BE(finalValue[0], 0);\n                buffer.writeUint16BE(finalValue[1], 2);\n                finalValue = buffer.readFloatBE(0);\n            }\n\n            if (mapping.scale_factor !== undefined && mapping.data_type !== \"boolean\" && mapping.data_type !== \"bool\") {\n                finalValue = parseFloat((finalValue * mapping.scale_factor).toFixed(4));\n            }\n\n            if (mapping.data_type === \"boolean\" || mapping.data_type === \"bool\") {\n                finalValue = Boolean(finalValue);\n            }\n\n            const lastValue = deviceState[mapping.name];\n            if (lastValue !== finalValue) {\n\n                deviceState[mapping.name] = finalValue;\n\n                const unit = (mapping.unit === \"null\" || !mapping.unit) ? null : mapping.unit;\n                mappedData.push({\n                    name: mapping.name,\n                    value: finalValue,\n                    unit: unit,\n                    data_type: mapping.data_type === \"bool\" ? \"boolean\" : mapping.data_type\n                });\n            }\n        }\n    }\n\n    lastValuesCache[deviceId] = deviceState;\n    context.set(\"lastValuesCache\", lastValuesCache);\n\n    if (mappedData.length === 0) {\n        return null;\n    }\n\n    msg.payload = {\n        timestamp: payloadIn.timestamp,\n        source: {\n            type: \"edge_gateway\",\n            id: payloadIn.gateway_id || manifest.gateway_id\n        },\n        asset_context: {\n            standard: foundDevice.asset_context?.standard || \"ISA-95\",\n            path: assetPath\n        },\n        data: mappedData\n    };\n\n    return msg;\n\n} catch (err) {\n    node.error(`Erro crítico no processamento ISA-95: ${err.message}`, msg);\n    return null;\n}",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
