                      { "type": "equipment", "id": "ESP32_A" }
                    ]
                  },
                  "metrics_mapping": {
                    "temperature": { "name": "Temperature", "scale_factor": 1.0, "unit": "°C", "data_type": "float" },
                    "running":     { "name": "Running",     "scale_factor": 1.0, "unit": "",   "data_type": "bool" }
                  }
                }
              }
            }
          }
        }
      }
