                    "40001": { "register_type": "holding", "name": "Temperature", "scale_factor": 0.1, "unit": "°C", "data_type": "int16" },
                    "40002": { "register_type": "holding", "name": "Running", "scale_factor": 1.0, "unit": "", "data_type": "bool" }
                  }
                },

                "esp32_a": {
                  "_comment": "Dispositivo Classe 1 SEM CLP (Etapa 2). protocol='interedge': o dispositivo EMPURRA leituras pelo broker de ingestao (sida/ingest/esp32_a/telemetry), entao NAO ha host/port/scan_rate_ms/register_type. As chaves do metrics_mapping sao os nomes logicos do `readings` que o dispositivo publica. O asset_context ISA-95 mapeia o ESP32 na hierarquia (prova do nivel organizacional para fonte sem CLP).",
                  "enabled": true,
                  "connection": { "protocol": "interedge" },
                  "asset_context": {
                    "standard": "ISA-95",
                    "path": [
                      { "type": "area", "id": "Area_1" },
